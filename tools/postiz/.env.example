# Postiz self-host configuration for A Podcast Geek
# Copy to .env in this directory and fill in. NEVER commit the filled .env.

# === Required ===
# The exact public URL you will browse Postiz on. Must be HTTPS for Meta OAuth
# to work. Put this behind a reverse proxy (Caddy/nginx/Cloudflare Tunnel).
MAIN_URL="https://social.apodcastgeek.com"

# Generate with: openssl rand -hex 48
JWT_SECRET=""

# Change these before exposing the host to the internet.
POSTGRES_USER="postiz-user"
POSTGRES_PASSWORD="postiz-password"
POSTGRES_DB="postiz-db-local"

# Set to 'true' after you have created your own account, so the public
# instance does not accept new signups.
DISABLE_REGISTRATION="false"

# === Instagram / Facebook ===
# Instagram has NO env vars of its own in Postiz - it authenticates through
# the Meta app below. See README.md for the Meta for Developers setup.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# === Other channels (optional - leave blank to hide) ===
THREADS_APP_ID=""
THREADS_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""

# === Optional: AI caption generation ===
OPENAI_API_KEY=""
